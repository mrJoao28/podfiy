NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional; nunca expor no cliente. O app usa RLS e não precisa desta chave.
SUPABASE_SERVICE_ROLE_KEY=

# Apenas em proxy próprio que substitui X-Forwarded-For e bloqueia acesso direto.
# Na Vercel, a identificação do cliente é automática.
TRUST_PROXY=false
